<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="4dp" android:paddingEnd="4dp"
    android:paddingTop="4dp" android:paddingBottom="4dp" android:background="@android:color/transparent">

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="8dp" android:paddingEnd="8dp">
        <ImageView android:id="@+id/status_icon" android:layout_width="40dp" android:layout_height="40dp"
            android:src="@drawable/ic_bulb_nodata" android:contentDescription="Стан світла" />
        <TextView android:id="@+id/location" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:text="ЧЕРГА 6.1 · ENERGY-UA" android:textColor="#F0F4F7"
            android:textSize="11sp" android:textStyle="bold" android:fontFamily="sans" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/countdown" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--:--" android:textColor="#B9E2C9" android:textSize="26sp" android:textStyle="bold" android:fontFamily="monospace" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
            <TextView android:id="@+id/countdown_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="очікуємо графік" android:textColor="#F0F4F7" android:textSize="10sp" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        </LinearLayout>
    </LinearLayout>

    <ImageView android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="46dp"
        android:layout_marginTop="2dp" android:scaleType="fitXY" android:contentDescription="Шкала відключень" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:paddingTop="2dp" android:paddingBottom="2dp" android:paddingStart="6dp" android:paddingEnd="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="start" android:text="00:00" android:textColor="#F0F4F7" android:textSize="10sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="06:00" android:textColor="#F0F4F7" android:textSize="10sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="12:00" android:textColor="#F0F4F7" android:textSize="10sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:gravity="center" android:text="18:00" android:textColor="#F0F4F7" android:textSize="10sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="24:00" android:textColor="#F0F4F7" android:textSize="10sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="5" android:shadowDx="0" android:shadowDy="1" />
    </LinearLayout>
</LinearLayout>
